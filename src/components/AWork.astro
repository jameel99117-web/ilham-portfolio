---
const { caption, cssClass, index, site, images = [], total } = Astro.props

// A random string with the syntax '[a-z][0-9]{3}-index-total'
const key = Math.random().toString(36).slice(2, 6) + '-' + index + '/' + total
---

<a-work class={cssClass}>
  <div class="a__inner">
    <a href={site} target="_blank" rel="noopener">
      <div class="a__collage" data-count={images.length}>
        {
          images.map((image) => (
            <img
              data-src={image.src}
              alt={`${caption} – ${image.caption}`}
              class="a__img js-img"
              decoding="async"
            />
          ))
        }
      </div>

      <div class="a__caption">
        <div class="a__caption__text">
          {caption}
        </div><!-- .a__caption__text -->

        <div class="a__caption__key">
          #{key}
        </div><!-- .a__caption__key -->
      </div><!-- .a__caption -->
    </a>
  </div><!-- .a__inner -->
</a-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement

    isActive: boolean

    /**
     * Init
     */
    connectedCallback() {
      // Elements
      this.link = this.querySelector('a')

      // Properties
      this.isActive = false

      // Events
      this.link.addEventListener('click', this.onClick.bind(this))
    }

    /**
     * Attribute changed
     */
    attributeChangedCallback(name, oldValue, newValue) {
      if (name === 'progress') {
        this.style.setProperty('--progress', newValue)

        if (newValue === '1' || newValue === '-1') {
          if (this.isActive) {
            this.outView()
          }
        } else {
          if (!this.isActive) {
            this.inView()
          }
        }
      }
    }

    /**
     * Gets in view
     */
    inView() {
      this.isActive = true

      this.classList.add('is-inview')
    }

    /**
     * Gets out view
     */
    outView() {
      this.isActive = false

      this.classList.remove('is-inview')
    }

    /**
     * On click
     */
    onClick(event: MouseEvent) {
      if (this.link.href.includes('#')) {
        event.preventDefault()
        return false
      }
    }
  }

  customElements.define('a-work', AWork)
</script>

<style lang="scss">
  a-work {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(frame);
    content-visibility: hidden;

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;

      text-decoration: none;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    // A frame is a 16:10 collage of every screenshot of one project
    // (1 to 4 images). The shape is fixed, so the frame keeps its size
    // while the screenshots are still loading.
    .a__collage {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      gap: 3px;

      width: min(56vw, 89.6vh);
      max-height: 56vh;
      aspect-ratio: 16 / 10;

      background: color(frame);

      @include mq(phone) {
        width: min(84vw, 134vh);
        max-height: 84vh;
      }

      &[data-count='2'] {
        grid-template-columns: 1fr 1fr;
      }

      // 3 images: one large on the left, two stacked on the right
      &[data-count='3'] {
        grid-template-columns: 1.6fr 1fr;
        grid-template-rows: 1fr 1fr;

        .a__img:first-child {
          grid-row: 1 / 3;
        }
      }

      // 4 images: 2 x 2
      &[data-count='4'] {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
      }
    }

    .a__img {
      display: block;

      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 0;

      background: color(shadow);
      object-fit: cover;
      object-position: top center;
    }

    .a__caption {
      @include flex(row, center, space-between);

      padding: 0.5rem 0.5rem;

      color: color(white);
      font: 700 11px / 1 font-family(fraktion);
      letter-spacing: 0.15em;
      text-align: right;
      text-transform: uppercase;

      @include mq(phone) {
        display: none;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }
  }
</style>
